# Copy to .env beside this file. docs/developer/connectivity-service.md explains each.

# The domain the service answers on. Needs an A record, and a wildcard A record, at this server.
CREW_RELAY_DOMAIN=relay.example.org
# Let's Encrypt writes here about certificates.
ACME_EMAIL=you@example.org

# Who may host through this service. Pick one.
#   CREW_RELAY_OPEN=1: any copy of Crew Office, within the limits below. What a build with this
#                      address stamped into it needs, since a key in a download is not a secret.
#   CREW_RELAY_KEY:    only hosts given this key, under Advanced settings.
CREW_RELAY_OPEN=1
CREW_RELAY_KEY=

# Bearer token for /_relay/metrics. Without one, and without a key, metrics are off.
CREW_RELAY_METRICS_KEY=

# Limits. Empty uses the default.
CREW_RELAY_MAX_TUNNELS=50
CREW_RELAY_TUNNELS_PER_IP=5
# Each office's traffic a day, in MB, both directions together. Default 5120 when open, none otherwise.
CREW_RELAY_DAILY_MB=
CREW_RELAY_MAX_BODY_MB=512
