# Example security settings for Crew Office. Copy what you need into .env beside the app.
# Nothing here is required: the defaults are the safe choice, and these only make things stricter.

# Run ALL agent code in Docker, including your own solo projects.
# CREW_SANDBOX=docker
# CREW_SANDBOX_IMAGE=node:22-alpine

# Listen only on this computer. Friends then need the relay.
# HOST=127.0.0.1

# Worker: jobs at once on this computer.
# CREW_WORKER_CONCURRENCY=3

# The relay, on the server that runs it.
# CREW_RELAY_KEY=use-a-long-random-secret
# CREW_RELAY_DOMAIN=relay.example.com
# CREW_RELAY_TRUST_PROXY=1
# CREW_RELAY_RATE=1200

# Never set these on a real office:
# CREW_ALLOW_WEAK_SANDBOX=1   runs others' code without Docker; for tests. The Connections page asks properly.
# CREW_RELAY_OPEN=1           lets anyone use your relay
