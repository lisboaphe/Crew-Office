# Crew Office configuration. Copy to .env and fill in what you need.
# Never commit .env. The host serves no dotfiles, but keep it out of shared folders anyway.

# ---------- Room host ----------
# 127.0.0.1 = this computer only; 0.0.0.0 = your network (npm run host sets this).
HOST=0.0.0.0
PORT=8080
# host = Mode A (rooms live while this app runs); dedicated = Mode B (a server).
CREW_MODE=host
# Where rooms, projects, messages and crash logs are saved. Default: ~/.roving-office
# ROVING_OFFICE_STATE_DIR=/data
# LAN discovery broadcasts on this UDP port; 0 disables discovery.
# CREW_LAN=1
# CREW_LAN_PORT=41234
# Behind HTTPS reverse proxy: trust X-Forwarded-* headers.
# ROVING_OFFICE_TRUST_PROXY=1

# ---------- Agent worker (one player's machine) ----------
# Keys stay on the machine running the worker; the room host never receives them.
# Leave blank to enter them on the worker's settings page (http://127.0.0.1:8790) instead,
# where they are stored encrypted.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Local OpenAI-compatible server, e.g. Ollama:
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_API_KEY=
# The token from Dashboard → My workers → Connect a worker (docker compose worker profile).
CREW_WORKER_TOKEN=
# CREW_WORKER_DIR=~/.crew-worker
# CREW_WORKER_PORT=8790
# CREW_WORKER_CONCURRENCY=3
# Sandbox for agent-run code: process (Node permission model) or docker (no network).
# CREW_SANDBOX=process
# CREW_SANDBOX_IMAGE=node:22-alpine
